@model IEnumerable<PedidosWebUpgrade.Domain.Entities.Almacen>

<h1>Almaces</h1>
<table>
    <thead>
        <tr>
            <td>
                IdAlmacen
            </td>
            <td>
                Descripcion
            </td>
        </tr>
    </thead>
    <tbody>
        @foreach(var datos in Model)
        {
            <tr>
                <td>@datos.IdAlmacen</td>
                <td>@datos.Descripcion</td>
            </tr>
        }
    </tbody>
</table>
