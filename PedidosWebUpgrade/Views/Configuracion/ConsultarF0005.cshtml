@{
    @model PedidosWebUpgrade.Domain.ViewModels.ConsultarF0005ViewModel
    ViewBag.Title = "Maestros";
    ViewBag.pTitle = "Listado de código F0005";
    ViewBag.pageTitle = "Maestros";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles {

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <!--datatable css-->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css" />
    <!--datatable responsive css-->
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.2.9/css/responsive.bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.dataTables.min.css">
}

<div class="accordion custom-accordionwithicon custom-accordion-border accordion-border-box accordion-secondary" id="accordionFiltro">
    <div class="accordion-item">
        <h2 class="accordion-header" id="accordionborderedFiltro">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#accor_borderedFiltro" aria-expanded="true" aria-controls="accor_borderedFiltro">
                Parámetros de búsqueda
            </button>
        </h2>
        <div id="accor_borderedFiltro" class="accordion-collapse collapse show" aria-labelledby="accordionborderedFiltro" data-bs-parent="#accordionFiltro">
            <div class="card-header">
                &nbsp;&nbsp;&nbsp;Filtre los resultados en base a los siguientes entradas:
            </div>
            <div class="accordion-body">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="card">
                            <div class="card-body">
                                <form asp-action="ConsultarF0005" asp-controller="Configuracion" method="post">
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="row align-bottom">
                                                <div class="col-md-2 m-1">
                                                    <label class="form-label">Código del producto:</label>
                                                    <select class="js-example-basic-single" asp-items="@(new SelectList(Model.Productos, "Codigo", "Descripcion"))" asp-for="CodigoProducto">
                                                    </select>
                                                </div><!-- end col -->
                                                <div class="col-md-3 m-1">
                                                    <label class="form-label">Código definido por el usuario:</label>
                                                    <select class="js-example-basic-single" asp-items="@(new SelectList(Model.CodigoUsuarios, "Codigo", "Descripcion"))" asp-for="CodigoUsuario">
                                                    </select>
                                                </div><!-- end col -->
                                                <div class="col-md-2 m-1">
                                                    <label class="form-label">UDC:</label>
                                                    <input type="text" class="form-control" readonly size="1">
                                                </div><!-- end col -->
                                                <div class="col-md-5 m-1 position-absolute bottom-0 end-0 text-end">
                                                    <button type="submit"
                                                       title="Nuevo" id="btnbuscar" data-authorization="authorization" data-crud="read"
                                                       class="btn btn-secondary btn-label waves-effect waves-light">
                                                        <i class="ri-file-line label-icon fs-16 me-2"></i> Buscar
                                                    </button>
                                                    <a type="button" href="@Url.Action("ConsultarF0005","Configuracion")"
                                                       title="Nuevo" id="btncancelar" data-authorization="authorization" data-crud="read"
                                                       class="btn btn-danger btn-label waves-effect waves-light">
                                                        <i class="ri-file-line label-icon align-middle fs-16 me-2"></i> Cancelar
                                                    </a>
                                                </div><!-- end col -->
                                            </div><!-- end row -->
                                        </div><!-- end col -->
                                    </div><!-- end row -->
                                </form>                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="row">
            <div class="col-lg-8">
            </div><!-- end col -->
            <div class="col-lg-2">
            </div><!-- end col -->
            <div class="col-lg-2">
                <div class="card card-body text-end">
                    <a type="button" href="@Url.Action("DetalleF0005","Configuracion", new { dtsy = "" , dtrt = "" })"
                       title="Nuevo" id="btncreate" data-authorization="authorization" data-crud="create"
                       class="btn btn-secondary btn-label waves-effect waves-light">
                        <i class="ri-file-line label-icon align-middle fs-16 me-2"></i> Nuevo
                    </a>
                </div>
            </div><!-- end col -->
        </div><!-- end row -->
    </div><!-- end col -->
</div><!-- end row -->

<div class="accordion custom-accordionwithicon custom-accordion-border accordion-border-box accordion-secondary" id="accordionBordered">
    <div class="accordion-item">
        <h2 class="accordion-header" id="accordionborderedExample1">
            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#accor_borderedExamplecollapse1" aria-expanded="true" aria-controls="accor_borderedExamplecollapse1">
                Códigos F0005 Registrados
            </button>
        </h2>
        <div id="accor_borderedExamplecollapse1" class="accordion-collapse collapse show" aria-labelledby="accordionborderedExample1" data-bs-parent="#accordionBordered">
            <div class="accordion-body">
                @* @if (Model.Count > 0)
                { *@
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="card">
                                <div class="card-body">
                                    @Html.Partial("_ListF0005", Model.ListF0005)
                                </div>
                            </div>
                        </div>
                    </div>
                @* } *@
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>

    <!--datatable js-->
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.html5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>

    <!--select2 cdn-->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="~/assets/js/pages/select2.init.js"></script>

    <script src="~/assets/js/pages/datatables.init.js"></script>
}